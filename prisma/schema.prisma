generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  deliveryMode   String   @default("simulation") // simulation | extension | api
  extensionCode  String?  @unique // pairing code for the browser extension
  extensionName  String?  // label of the paired browser, once connected
  extensionPairedAt DateTime?
  createdAt      DateTime @default(now())

  members       Membership[]
  accounts      LinkedinAccount[]
  leads         Lead[]
  lists         List[]
  campaigns     Campaign[]
  conversations Conversation[]
  activityLogs     ActivityLog[]
  extensionJobs    ExtensionJob[]
  linkedinProfiles LinkedInProfile[]
  selections       OutreachSelection[]
  templates        Template[]
  blacklist        BlacklistEntry[]
  scheduledActions ScheduledAction[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  subscription     Subscription?
}

// A job queued for the paired browser extension to execute on LinkedIn.
model ExtensionJob {
  id          String    @id @default(cuid())
  workspaceId String
  campaignId  String?
  memberId    String? // CampaignMember id this job advances
  leadId      String
  action      String    // connect | message | follow_up | reaction
  payload     Json?     @default("{}")
  status      String    @default("queued") // queued | in_progress | done | failed
  error       String?
  attempts    Int       @default(0)
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("member") // owner | admin | member
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// A connected LinkedIn profile ("avatar") that runs campaigns.
model LinkedinAccount {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  headline        String?
  profileUrl      String?
  avatarUrl       String?
  email           String?   // from LinkedIn OAuth
  linkedinId      String?   @unique // LinkedIn's unique member ID (sub from OIDC)
  accessToken     String?   // OAuth access token
  refreshToken    String?   // OAuth refresh token
  tokenExpiry     DateTime? // when the access token expires
  // Server-side login credentials (encrypted at rest)
  linkedinLogin   String?   // LinkedIn login email (for server-side auth)
  passwordEnc     String?   // AES-256-GCM encrypted LinkedIn password
  sessionStatus   String    @default("idle") // idle | logging_in | logged_in | session_expired | banned
  lastSessionAt   DateTime? // when the headless session was last active
  warmupDay       Int       @default(0)  // day 0-14 of warm-up (0 = not started)
  warmupStartedAt DateTime?
  sentToday       Int       @default(0)  // actions sent today
  sentTodayDate   String?   // date of sentToday (YYYY-MM-DD)
  status          String    @default("active") // active | paused
  dailyLimit      Int       @default(15) // conservative default for server-side
  createdAt       DateTime  @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  conversations Conversation[]

  @@index([workspaceId])
}

model Lead {
  id               String   @id @default(cuid())
  workspaceId      String
  linkedinProfileId String?  // link to discovered profile
  name             String
  headline         String?
  company          String?
  jobTitle         String?
  linkedinUrl      String?
  location         String?
  email            String?
  phone            String?
  about            String?
  industry         String?
  avatarUrl        String?
  notes            String?
  source           String   @default("manual") // manual | csv | event | import | outreach
  status           String   @default("new") // new | saved | queued | connection_pending | connected | message_pending | messaged | replied | not_interested | blacklisted | completed | failed | booked | negative
  tags             Json?    @default("[]")
  listId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedinProfile  LinkedInProfile?   @relation("LinkedInProfileToLead", fields: [linkedinProfileId], references: [id])
  list             List?              @relation(fields: [listId], references: [id], onDelete: SetNull)
  campaignMembers  CampaignMember[]
  conversations    Conversation[]

  @@unique([linkedinProfileId])
  @@index([workspaceId])
  @@index([status])
  @@index([linkedinProfileId])
}

model List {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#4f46e5")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@index([workspaceId])
}

model Campaign {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  type             String    @default("outbound") // outbound | inbound
  kind             String    @default("connections") // connections | messages | reactions
  status           String    @default("draft") // draft | running | paused | finished
  linkedinAccountId String?
  dailyLimit       Int       @default(30)
  minDelayMin      Int       @default(3)
  maxDelayMin      Int       @default(8)
  smartTimezone    Boolean   @default(true)
  autoTranslate    Boolean   @default(false)
  aiPersonalization Boolean  @default(true)
  startDate        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        LinkedinAccount? @relation(fields: [linkedinAccountId], references: [id], onDelete: SetNull)
  steps          CampaignStep[]
  members        CampaignMember[]

  @@index([workspaceId])
}

model CampaignStep {
  id          String   @id @default(cuid())
  campaignId  String
  position    Int
  action      String   // connect | message | follow_up | reaction
  daysAfter   Int      @default(0)
  template    String?
  variables   Json?    @default("[]") // [{ name, value }]
  attachments Json?    @default("[]")
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignMember {
  id         String    @id @default(cuid())
  campaignId String
  leadId     String
  status     String    @default("queued") // queued | sent | accepted | replied | booked | negative | skipped
  stepIndex  Int       @default(0)
  nextRunAt  DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?
  repliedAt  DateTime?
  bookedAt   DateTime?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
}

// The unified inbox — one conversation per lead.
model Conversation {
  id                String    @id @default(cuid())
  workspaceId       String
  linkedinAccountId String?
  leadId            String
  lastMessageAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         LinkedinAccount? @relation(fields: [linkedinAccountId], references: [id], onDelete: SetNull)
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@index([workspaceId])
  @@index([leadId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  direction      String    // out | in
  body           String
  status         String    @default("sent") // draft | queued | sent | failed
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  campaignId  String?
  leadId      String?
  type        String    // sent | accepted | replied | booked | imported | note | connection_sent | connection_accepted | message_sent | message_received | profile_viewed | campaign_started | campaign_paused
  message     String?
  meta        Json?  @default("[]")
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Discovered/searched LinkedIn profiles (not yet leads)
model LinkedInProfile {
  id              String   @id @default(cuid())
  workspaceId     String
  linkedinId      String?  // LinkedIn public identifier
  publicId        String?  // vanity URL slug
  firstName       String?
  lastName        String?
  fullName        String
  headline        String?
  company         String?
  jobTitle        String?
  location        String?
  industry        String?
  profileUrl      String?
  avatarUrl       String?
  about           String?
  connectionDegree Int?
  isPremium       Boolean  @default(false)
  isOpenToWork    Boolean  @default(false)
  isCreator       Boolean  @default(false)
  mutualConnections Int?
  raw             Json?    // full profile data from provider
  source          String   @default("search") // search | csv | import | manual | extension
  cachedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead         Lead?                  @relation("LinkedInProfileToLead")
  blacklist    BlacklistEntry?        @relation("LinkedInProfileToBlacklist")
  selections  OutreachSelection[]

  @@unique([workspaceId, linkedinId])
  @@index([workspaceId])
}

// Outreach selections — profiles the user has selected for action
model OutreachSelection {
  id              String   @id @default(cuid())
  workspaceId     String
  linkedinProfileId String
  selectedAt      DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedinProfile LinkedInProfile @relation(fields: [linkedinProfileId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, linkedinProfileId])
  @@index([workspaceId])
}

model Template {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  content     String
  category    String   @default("connection_note") // connection_note | first_message | follow_up | breakup
  variables   Json?    @default("[]")
  isDefault   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, category])
}

model BlacklistEntry {
  id              String   @id @default(cuid())
  workspaceId     String
  linkedinProfileId String?
  profileUrl      String?
  name            String?
  reason          String   @default("manual") // manual | already_contacted | competitor | existing_client | not_relevant | do_not_contact
  notes           String?
  addedBy         String?
  createdAt       DateTime @default(now())

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedinProfile LinkedInProfile? @relation("LinkedInProfileToBlacklist", fields: [linkedinProfileId], references: [id])

  @@unique([linkedinProfileId])
  @@index([workspaceId])
}

model ScheduledAction {
  id              String    @id @default(cuid())
  workspaceId     String
  campaignId      String
  leadId          String
  linkedinAccountId String?
  stepId          String?
  action          String    // profile_view | connection_request | message | follow_up | reaction
  payload         Json?     @default("{}")
  status          String    @default("queued") // queued | running | success | failed | retrying | cancelled
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  lastError       String?
  nextRetryAt     DateTime?
  result          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([status, scheduledAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String   // create | update | delete | login | logout | campaign_start | campaign_pause | connection_send
  resource    String?  // campaign | lead | account | template | settings
  resourceId  String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  type        String   // connection_accepted | lead_replied | campaign_completed | campaign_paused | account_disconnected | execution_failed | auth_required | daily_limit
  title       String?
  message     String?
  read        Boolean  @default(false)
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, read])
}

model Plan {
  id             String   @id @default(cuid())
  name           String   @unique // free | starter | professional | agency
  displayName    String
  maxAccounts    Int      @default(1)
  maxCampaigns   Int      @default(1)
  maxLeads       Int      @default(100)
  maxMessagesDay Int      @default(50)
  priceMonthly   Int      @default(0) // cents
  features       Json?    @default("[]")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  planId       String
  status       String    @default("active") // active | past_due | cancelled | trial
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  stripeSubscriptionId String?
  stripeCustomerId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
}
